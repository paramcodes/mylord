{
  "name": "mylord",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "typescript": "5.9.3",
    "tailwindcss": "4.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "next": "16.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.0.0",
    "eslint": "9.0.0",
    "eslint-config-next": "16.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "oxfmt . && bun run lint",
    "format:check": "oxfmt --check .",
    "test": "turbo test",
    "deploy:convex": "bun --filter @mylord/convex deploy:prod"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
