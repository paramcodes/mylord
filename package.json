{
  "name": "mylord",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "oxfmt . && bun run lint",
    "format:check": "oxfmt --check .",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "latest"
  }
}
