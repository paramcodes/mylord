# Clerk (development instance keys for local dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Clerk production instance (set in Vercel for prod)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
# CLERK_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# CLERK_SIGN_IN_URL=/sign-in
# CLERK_SIGN_UP_URL=/sign-up

NEXT_PUBLIC_CONVEX_URL=

# Demo mode: run the app on an in-memory seed, no Clerk or Convex credentials.
# Set both to 1: DEMO_MODE for the server, NEXT_PUBLIC_DEMO_MODE for the client.
DEMO_MODE=
NEXT_PUBLIC_DEMO_MODE=
